NODE_ENV=development
PORT=5000
# Optional in development. Without it, the API starts an ephemeral seeded MongoDB instance.
# MONGO_URI=mongodb://127.0.0.1:27017/unfazed
# Required only if you want to prohibit the ephemeral development fallback.
# USE_IN_MEMORY_DB=false
# Required in production. Use a long, random value outside local development.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Razorpay test keys are needed to use the live Razorpay test checkout. Without these,
# development uses a clearly-labelled demo confirmation payment flow.
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_test_secret
# Comma separated URLs. Vite's standard port is included by default.
CLIENT_URL=http://localhost:5173
# Optional email delivery. Without these, email is logged as a safe development stub.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Unfazed <no-reply@example.com>
